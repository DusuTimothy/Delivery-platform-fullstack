PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=delivery_platform_dev
# Set to certs/ca.pem when using the Aiven CA certificate.
DB_SSL_CA_PATH=

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=24h

BCRYPT_ROUNDS=10
